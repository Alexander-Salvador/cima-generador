+func colIdx(cell string) int {
+	col := 0
+	for _, c := range cell {
+		if c >= 'A' && c <= 'Z' {
+			col = col*26 + int(c-'A'+1)
+		}
+	}
+	return col - 1
+}
+
+func llamadasFirstRow(agenteID int) int {
+	for i, l := range llamadas {
+		if l.FK == agenteID {
+			return i + 2
+		}
+	}
+	return 2
+}
+
+func personalRowForFK(fk int) int {
+	for _, a := range agentes {
+		if a.ID == fk {
+			return a.PersonalRow
+		}
+	}
+	return 0
+}
