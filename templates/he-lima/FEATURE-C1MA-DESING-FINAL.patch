+
+func colIdx(cell string) int {
+	col := 0
+	for _, c := range cell {
+		if c >= 'A' && c <= 'Z' {
+			col = col*26 + int(c-'A'+1)
+		}
+	}
+	return col - 1
+}
+
+func clearCell(col string, row int) map[string]any {
+	ci := colIdx(col)
+	ri := row - 1
+	return map[string]any{
+		"updateCells": map[string]any{
+			"range": map[string]any{
+				"sheetId":          sheetFB,
+				"startRowIndex":    ri,
+				"endRowIndex":      ri + 1,
+				"startColumnIndex": ci,
+				"endColumnIndex":   ci + 1,
+			},
+			"rows": []any{
+				map[string]any{
+					"values": []any{
+						map[string]any{
+							"userEnteredValue": map[string]any{"stringValue": ""},
+						},
+					},
+				},
+			},
+			"fields": "userEnteredValue",
+		},
+	}
+}
+
+func setValue(col string, row int, value string) map[string]any {
+	ci := colIdx(col)
+	ri := row - 1
+	return map[string]any{
+		"updateCells": map[string]any{
+			"range": map[string]any{
+				"sheetId":          sheetFB,
