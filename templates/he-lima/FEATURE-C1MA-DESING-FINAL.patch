+func colIdx(cell string) int {
+	col := 0
+	for _, c := range cell {
+		if c >= 'A' && c <= 'Z' {
+			col = col*26 + int(c-'A'+1)
+		}
+	}
+	return col - 1
+}
+
+func deleteDimensionCols(sheetID int64, startIdx, endIdx int) map[string]any {
+	return map[string]any{
+		"deleteDimension": map[string]any{
+			"range": map[string]any{
+				"sheetId":    sheetID,
+				"dimension":  "COLUMNS",
+				"startIndex": startIdx,
+				"endIndex":   endIdx,
+			},
+		},
+	}
+}
+
+func setValue(col string, row int, value string, sheetID int64) map[string]any {
+	ci := colIdx(col)
+	ri := row - 1
+	return map[string]any{
+		"updateCells": map[string]any{
+			"range": map[string]any{
+				"sheetId":          sheetID,
+				"startRowIndex":    ri,
+				"endRowIndex":      ri + 1,
+				"startColumnIndex": ci,
+				"endColumnIndex":   ci + 1,
+			},
+			"rows": []any{
+				map[string]any{
+					"values": []any{
+						map[string]any{
+							"userEnteredValue": map[string]any{"stringValue": value},
+						},
+					},
+				},
+			},
+			"fields": "userEnteredValue",
+		},
+	}
+}
+
+func setFormula(col string, row int, formula string, sheetID int64) map[string]any {
+	ci := colIdx(col)
+	ri := row - 1
+	return map[string]any{
+		"updateCells": map[string]any{
+			"range": map[string]any{
+				"sheetId":          sheetID,
+				"startRowIndex":    ri,
+				"endRowIndex":      ri + 1,
+				"startColumnIndex": ci,
+				"endColumnIndex":   ci + 1,
+			},
+			"rows": []any{
+				map[string]any{
