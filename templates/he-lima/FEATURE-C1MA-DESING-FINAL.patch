+		reqs = append(reqs, setValue("C", row, "HUERTA SALVADOR WILLIAMS ALEXANDER", sheetFB))
+		// D (CANT_CALLS) → COUNTIF cross-tab
+		reqs = append(reqs, setFormula("D", row,
