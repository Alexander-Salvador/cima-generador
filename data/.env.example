# Data files for CIMA
# CIMA-specific configs: agent lists, spreadsheet IDs, etc.

# Spreadsheet IDs
# Update with real IDs from your Google Drive:
# - CIMA_SHEET_ID: main CIMA spreadsheet (HE/TE/FEEDBACK/CONFIG)
# - CITRIX_SHEET_ID: CITRIX_UPDATE_LOG_RRHH (separate file)
CIMA_SHEET_ID=your-cima-spreadsheet-id-here
CITRIX_SHEET_ID=1MQ3wts_cEG_4Dp5U6X4gehEn6u7F61tIl7KHzSzKw0Y

# Agent list (PERSONAL sheet mirror — kept locally for offline reference)
# Format: id,name,turno_id,regime,supervisor
# - regime: FT/PT/MF (full-time / part-time / mixed)
# - turno_id: T01-T10 (T01/T08=PT, T09/T10=MF, rest=FT)
# Run: ovav-sheets personal export --out data/agents.csv
# agents.csv

# OAuth scopes required for sheets bridge
OAUTH_SCOPES=https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/drive.file